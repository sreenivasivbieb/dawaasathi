# Dawaa Saathi configuration. Copy to .env (never commit .env) and fill in the keys.
# Every variable is optional: with no keys the app runs with mock STT/TTS (typed queries,
# browser speechSynthesis) and Tesseract OCR if it is installed.

# --- Gnani speech (Prisma STT + Timbre TTS) -------------------------------------------------
# One key for both; sent as the X-API-Key-ID header. Empty = mock STT/TTS.
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_WS_URL=wss://api.vachana.ai

# Prisma STT. v3.0 sends format, topic, keyterms and previous_text; older models use bias_list.
# Default v2.5: on synthetic Hindi drug queries it kept brand + number ("पैन 40") where v3.0 lost them.
PRISMA_MODEL=prisma-v2.5
# 1 = also run PRISMA_MODEL_2 in parallel and keep the transcript the drug DB matches best
# (same latency, twice the STT credits).
PRISMA_DUAL=0
PRISMA_MODEL_2=prisma-v3.0
# codemix keeps English drug names in Latin script inside Hindi speech.
PRISMA_FORMAT=codemix
# 1 = request "<lang>,en-IN" (e.g. hi-IN,en-IN) so English brand names are recognised.
PRISMA_ADD_ENGLISH=1
# How many top brand names to send as keyterms (biasing); the request sends at most 200.
PRISMA_KEYTERMS=150

# Timbre TTS. Replies are streamed as raw 16-bit PCM over SSE; phone mode asks for 8000.
TIMBRE_MODEL=timbre-v3.0
TIMBRE_VOICE=Shivani
TIMBRE_SAMPLE_RATE=24000
TIMBRE_SPEED=1.0

# --- OCR (strip / prescription photos) ------------------------------------------------------
# Tried in order; a provider without a key (or without the tesseract binary) is skipped.
# rapidocr = offline PP-OCR (ONNX); also cross-checks the VLM read. Pack detector (YOLO-World,
# ONNX) is used when DETECTOR_MODEL exists: build it once with scripts/export_yolo.py.
OCR_PROVIDERS=groq,anthropic,rapidocr,tesseract
DETECTOR_MODEL=var/models/pack_detector.onnx
# Groq vision model. GROQ_API_KEYS is a comma list rotated on HTTP 429; GROQ_API_KEY is added to it.
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Claude fallback (read by the anthropic SDK; ANTHROPIC_AUTH_TOKEN also works).
ANTHROPIC_API_KEY=
ANTHROPIC_OCR_MODEL=claude-opus-5-5

# --- LLM (Groq) for understanding the transcript and wording the reply ----------------------
# Uses the same GROQ_API_KEY(S) as OCR. The LLM never supplies medical facts: drug names are
# resolved against the DB, and a reworded reply must pass the guard or the template is spoken.
# off | nlu | reply | both
LLM_MODE=both
# openai/gpt-oss-120b (better Hindi) or openai/gpt-oss-20b (faster); see GET /openai/v1/models
GROQ_LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_S=6

# --- Data and state -------------------------------------------------------------------------
# SQLite DB built by `python -m scripts.load_data` and the TTS segment cache directory.
# Defaults: <repo>/var/dawasaathi.db and <repo>/var/tts_cache (the Docker image sets /app/var/...).
# DAWA_DB_PATH=/absolute/path/dawasaathi.db
# DAWA_CACHE_DIR=/absolute/path/tts_cache
# Banned list / price data older than this many days is treated as stale -> UNVERIFIED / no price claim.
DATA_STALE_DAYS=400
# NPPA ceiling prices exclude GST; the "above ceiling" check uses ceiling x (1 + GST%).
NPPA_GST_PCT=12
# Sessions (transcript, matched ids, verdict) are kept in memory only, for this many seconds.
SESSION_TTL_S=900

# --- Matcher thresholds (tune with scripts/run_eval.py) -------------------------------------
# Accept the top brand only if score >= MATCH_T1 and it leads #2 by >= MATCH_T2; else ask.
MATCH_T1=0.80
MATCH_T2=0.06

# --- Limits and admin -----------------------------------------------------------------------
MAX_AUDIO_BYTES=6291456
MAX_IMAGE_BYTES=10485760
# Requests per minute per client IP on /v1/query and /v1/confirm.
RATE_LIMIT_PER_MIN=40
# Required (as X-Admin-Token) for POST /v1/tts/prewarm. Empty = prewarm disabled.
ADMIN_TOKEN=

# --- Deployment -----------------------------------------------------------------------------
# Public https:// origin of the deployment (optional; read into settings, not used by any route yet).
PUBLIC_BASE_URL=

# --- WhatsApp Cloud API (stretch, untested against Meta) -------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# If set, inbound webhooks must carry a valid X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Read at import time from the process environment (not from .env).
WHATSAPP_GRAPH_VERSION=v21.0

# ---- Web lookup of a salt's usual use (only when salts.csv has no entry for it)
# Tavily search on trusted medical sites -> Groq LLM picks tags + copies one sentence -> code checks
# the sentence is in the source. Needs GROQ_API_KEY(S) too. Cached in var/web_uses.json.
TAVILY_API_KEY=
WEB_LOOKUP=1

# --- Guardrails -------------------------------------------------------------------------------
# 1 = include internal debug data in API responses (raw LLM output, OCR / provider details) for
# web/test.html. Keep 0 in any deployment: clients then get only the answer and data provenance.
EXPOSE_DEBUG=0
