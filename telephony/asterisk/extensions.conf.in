; Generated stage: __STAGE__. Only the loopback-authenticated endpoint can enter.
[dawa-local]
exten => 700,1,NoOp(DawaaSaathi local __STAGE__ test)
 same => n,Answer()
 same => n,Set(TIMEOUT(absolute)=180)
__CALL_BODY__
 same => n,Hangup()

; Account 1001 is also a convenient alias for the assistant. Never ring the
; same softphone back while it is already making this test call.
exten => 1001,1,Goto(dawa-local,700,1)
