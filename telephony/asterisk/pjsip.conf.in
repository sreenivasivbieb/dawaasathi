[global]
type=global
user_agent=DawaaSaathi-Local-Test

[transport-local]
type=transport
protocol=udp
; Linphone may bind its own default client socket to 5060.
bind=127.0.0.1:5070

[1001]
type=endpoint
transport=transport-local
context=dawa-local
disallow=all
allow=ulaw,alaw
auth=1001-auth
aors=1001
direct_media=no
dtmf_mode=rfc4733
force_rport=yes
rewrite_contact=yes
rtp_symmetric=yes
deny=0.0.0.0/0
permit=127.0.0.1/32
media_address=127.0.0.1
bind_rtp_to_media_address=yes

[1001-auth]
type=auth
auth_type=userpass
username=1001
password=__SIP_PASSWORD__

[1001]
type=aor
max_contacts=1
remove_existing=yes
minimum_expiration=60
default_expiration=300
maximum_expiration=600
